{% comment %}
  Adivasi Herbal Heritage 4-Step Process Section
  Visual 4-step ancestral brewing process timeline on desktop / swipeable cards on mobile.
{% endcomment %}

<div class="adivasi-process section-{{ section.id }}-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="adivasi-process__header">
      <span class="adivasi-process__pill">THE ANCESTRAL RITUAL</span>
      <h2 class="adivasi-process__title">How Our Sacred 108 Herb Oil Is Brewed</h2>
      <p class="adivasi-process__subtitle">
        Unlike commercial factory oils heated at high chemicals, we prepare each batch strictly adhering to authentic Vedic woodfire principles.
      </p>
    </div>

    <div class="adivasi-process__grid">
      <!-- Step 1 -->
      <div class="adivasi-process__card">
        <div class="adivasi-process__num-badge">01</div>
        <div class="adivasi-process__icon-wrap">🌿</div>
        <h3 class="adivasi-process__step-title">Wild Forest Harvesting</h3>
        <p class="adivasi-process__step-desc">
          Gathered by tribal elders at dawn from the deep Karnataka and Western Ghats forests to capture maximum botanical potency.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="adivasi-process__card">
        <div class="adivasi-process__num-badge">02</div>
        <div class="adivasi-process__icon-wrap">☀️</div>
        <h3 class="adivasi-process__step-title">Natural Sun-Drying</h3>
        <p class="adivasi-process__step-desc">
          Spread over organic bamboo mats and sun-cured naturally for 7 days to preserve active phytochemicals and natural aroma.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="adivasi-process__card">
        <div class="adivasi-process__num-badge">03</div>
        <div class="adivasi-process__icon-wrap">🔥</div>
        <h3 class="adivasi-process__step-title">12-Hr Woodfire Brewing</h3>
        <p class="adivasi-process__step-desc">
          Slowly simmered in heavy copper cauldrons over firewood using cold-pressed coconut and sesame base oils without synthetic additives.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="adivasi-process__card">
        <div class="adivasi-process__num-badge">04</div>
        <div class="adivasi-process__icon-wrap">🏺</div>
        <h3 class="adivasi-process__step-title">Double-Cloth Filtration</h3>
        <p class="adivasi-process__step-desc">
          Hand-filtered through traditional double-woven cotton cloth, leaving active herb extracts and microscopic root crystals inside.
        </p>
      </div>
    </div>

    <div class="adivasi-process__footer">
      <a href="{{ section.settings.cta_link }}" class="adivasi-process__cta">
        EXPERIENCE THE AUTHENTIC OIL &mdash; ORDER COD
      </a>
    </div>
  </div>
</div>

<style>
  .adivasi-process {
    padding: 60px 0;
    background: #fbf9f4;
  }

  .adivasi-process__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 44px;
  }

  .adivasi-process__pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.15);
    color: #926a11;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .adivasi-process__title {
    font-size: 32px;
    font-weight: 800;
    color: #0a3a2f;
    margin: 0 0 12px;
    line-height: 1.25;
  }

  .adivasi-process__subtitle {
    font-size: 14.5px;
    color: #4b5563;
    line-height: 1.5;
    margin: 0;
  }

  .adivasi-process__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .adivasi-process__card {
    position: relative;
    background: #ffffff;
    border-radius: 12px;
    padding: 26px 20px;
    border: 1px solid #ebdcc5;
    box-shadow: 0 4px 16px rgba(10, 58, 47, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .adivasi-process__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(10, 58, 47, 0.1);
    border-color: #c59b27;
  }

  .adivasi-process__num-badge {
    position: absolute;
    top: 14px;
    right: 16px;
    font-size: 22px;
    font-weight: 900;
    color: #ebdcc5;
  }

  .adivasi-process__icon-wrap {
    font-size: 32px;
    margin-bottom: 14px;
  }

  .adivasi-process__step-title {
    font-size: 16.5px;
    font-weight: 800;
    color: #0a3a2f;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .adivasi-process__step-desc {
    font-size: 13px;
    color: #4b5563;
    line-height: 1.45;
    margin: 0;
  }

  .adivasi-process__footer {
    text-align: center;
    margin-top: 40px;
  }

  .adivasi-process__cta {
    display: inline-block;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    padding: 13px 28px;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(22, 163, 74, 0.35);
    transition: transform 0.2s;
  }

  .adivasi-process__cta:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 990px) {
    .adivasi-process__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .adivasi-process {
      padding: 40px 0;
    }
    .adivasi-process__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .adivasi-process__title {
      font-size: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Adivasi Herbal Process",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF9F4"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link",
      "default": "/products/original-adivasi-hakki-pikki-hair-oil"
    }
  ],
  "presets": [
    {
      "name": "Adivasi Herbal Process"
    }
  ]
}
{% endschema %}

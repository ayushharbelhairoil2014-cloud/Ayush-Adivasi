{% comment %}
  Adivasi Policy & Compliance Container Section
{% endcomment %}

<div class="adivasi-policy-section section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    <div class="adivasi-policy-box">
      <span class="adivasi-policy-badge">{{ section.settings.policy_badge | default: "AYUSH ADIVASI OFFICIAL POLICY" }}</span>
      <h1 class="adivasi-policy-title">{{ section.settings.title }}</h1>
      <div class="adivasi-policy-meta">Last Updated: September 2026 &bull; Government of India E-Commerce Compliance</div>
      <div class="adivasi-policy-content">
        {{ section.settings.content }}
      </div>
    </div>
  </div>
</div>

<style>
  .adivasi-policy-section {
    padding: 44px 0 64px;
    background: #fbf9f4;
  }

  .adivasi-policy-box {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #ebdcc5;
    padding: 36px 32px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }

  .adivasi-policy-badge {
    display: inline-block;
    background: rgba(197, 155, 39, 0.15);
    color: #926a11;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .adivasi-policy-title {
    font-size: 28px;
    font-weight: 800;
    color: #0a3a2f;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .adivasi-policy-meta {
    font-size: 12px;
    color: #888888;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #eee7db;
  }

  .adivasi-policy-content h3 {
    font-size: 17px;
    font-weight: 800;
    color: #0a3a2f;
    margin: 20px 0 8px;
  }

  .adivasi-policy-content p {
    font-size: 13.5px;
    line-height: 1.6;
    color: #374151;
    margin: 0 0 14px;
  }

  .adivasi-policy-content ul {
    margin: 0 0 16px 20px;
    padding: 0;
    font-size: 13.5px;
    color: #374151;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .adivasi-policy-box {
      padding: 22px 18px;
    }
    .adivasi-policy-title {
      font-size: 22px;
    }
  }
</style>

{% schema %}
{
  "name": "Adivasi Policy Section",
  "settings": [
    {
      "type": "text",
      "id": "policy_badge",
      "label": "Badge",
      "default": "OFFICIAL STORE POLICY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Store Policy"
    },
    {
      "type": "html",
      "id": "content",
      "label": "Policy HTML Content"
    }
  ],
  "presets": [
    {
      "name": "Adivasi Policy Section"
    }
  ]
}
{% endschema %}

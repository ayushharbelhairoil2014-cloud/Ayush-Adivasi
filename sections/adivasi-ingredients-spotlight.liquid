{% comment %}
  Adivasi 108 Wild Herbs & Roots Spotlight Section
  High-converting visual showcase of sacred tribal botanical ingredients.
{% endcomment %}

<div class="adivasi-herbs-spotlight section-{{ section.id }}-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="adivasi-herbs-spotlight__header">
      <span class="adivasi-herbs-spotlight__pill">THE 108 JADI-BOOTIYAN</span>
      <h2 class="adivasi-herbs-spotlight__title">Sacred Forest Roots That Regrow Your Hair</h2>
      <p class="adivasi-herbs-spotlight__subtitle">
        Each bottle contains concentrated extracts of 108 handpicked wild forest herbs, free from silicones, artificial fragrance, or petroleum fillers.
      </p>
    </div>

    <div class="adivasi-herbs-spotlight__grid">
      <!-- Herb 1 -->
      <div class="adivasi-herb-card">
        <div class="adivasi-herb-card__top">
          <span class="adivasi-herb-card__tag">HERB #1</span>
          <span class="adivasi-herb-card__emoji">🌱</span>
        </div>
        <h4 class="adivasi-herb-card__name">Bhringraj (Keshraj)</h4>
        <span class="adivasi-herb-card__sanskrit">Eclipta Alba &bull; "King of Hair"</span>
        <p class="adivasi-herb-card__desc">
          Penetrates deep into follicles to reactivate dormant hair roots, dramatically halting shedding within 14 days.
        </p>
      </div>

      <!-- Herb 2 -->
      <div class="adivasi-herb-card">
        <div class="adivasi-herb-card__top">
          <span class="adivasi-herb-card__tag">HERB #2</span>
          <span class="adivasi-herb-card__emoji">🍃</span>
        </div>
        <h4 class="adivasi-herb-card__name">Brahmi Root</h4>
        <span class="adivasi-herb-card__sanskrit">Bacopa Monnieri &bull; Calming Adaptogen</span>
        <p class="adivasi-herb-card__desc">
          Reduces stress-induced hair loss by soothing cranial heat, nourishing follicles with essential alkaloids.
        </p>
      </div>

      <!-- Herb 3 -->
      <div class="adivasi-herb-card">
        <div class="adivasi-herb-card__top">
          <span class="adivasi-herb-card__tag">HERB #3</span>
          <span class="adivasi-herb-card__emoji">🍒</span>
        </div>
        <h4 class="adivasi-herb-card__name">Wild Jungle Amla</h4>
        <span class="adivasi-herb-card__sanskrit">Phyllanthus Emblica &bull; Vitamin C Power</span>
        <p class="adivasi-herb-card__desc">
          Contains 20x more natural Vitamin C than oranges. Prevents premature graying and protects hair protein structure.
        </p>
      </div>

      <!-- Herb 4 -->
      <div class="adivasi-herb-card">
        <div class="adivasi-herb-card__top">
          <span class="adivasi-herb-card__tag">HERB #4</span>
          <span class="adivasi-herb-card__emoji">🪵</span>
        </div>
        <h4 class="adivasi-herb-card__name">Jatamansi Roots</h4>
        <span class="adivasi-herb-card__sanskrit">Nardostachys Jatamansi &bull; Follicle Expander</span>
        <p class="adivasi-herb-card__desc">
          Clinically revered in Ayurveda to lengthen hair shaft growth phase (anagen) and increase individual follicle diameter.
        </p>
      </div>

      <!-- Herb 5 -->
      <div class="adivasi-herb-card">
        <div class="adivasi-herb-card__top">
          <span class="adivasi-herb-card__tag">HERB #5</span>
          <span class="adivasi-herb-card__emoji">🌾</span>
        </div>
        <h4 class="adivasi-herb-card__name">Dashamula Complex</h4>
        <span class="adivasi-herb-card__sanskrit">10 Sacred Vedic Tree Roots</span>
        <p class="adivasi-herb-card__desc">
          Ancient anti-inflammatory combination that repairs damaged scalps, balances tridosha, and strengthens root anchoring.
        </p>
      </div>

      <!-- Herb 6 -->
      <div class="adivasi-herb-card">
        <div class="adivasi-herb-card__top">
          <span class="adivasi-herb-card__tag">HERB #6</span>
          <span class="adivasi-herb-card__emoji">🌺</span>
        </div>
        <h4 class="adivasi-herb-card__name">Red Jungle Hibiscus</h4>
        <span class="adivasi-herb-card__sanskrit">Hibiscus Rosa-Sinensis &bull; Natural Keratin</span>
        <p class="adivasi-herb-card__desc">
          Stimulates keratin production for thick volume, restores glossy natural black shine, and seals split ends.
        </p>
      </div>
    </div>

    <!-- 108 Herb Banner Callout -->
    <div class="adivasi-herbs-spotlight__callout">
      <div class="adivasi-herbs-spotlight__callout-icon">🌿</div>
      <div class="adivasi-herbs-spotlight__callout-text">
        <strong>Plus 102 Other Wild Roots &amp; Barks:</strong> Nagarmotha, Shikakai, Neem, Gunja, Ratanjot, Lodhra, Methi, Devadaru, and pure cold-pressed botanical oils.
      </div>
      <a href="{{ section.settings.cta_link }}" class="adivasi-herbs-spotlight__callout-btn">
        ORDER COD TODAY &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .adivasi-herbs-spotlight {
    padding: 60px 0;
    background: #ffffff;
  }

  .adivasi-herbs-spotlight__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  .adivasi-herbs-spotlight__pill {
    display: inline-block;
    background: #eefbf1;
    color: #15803d;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 10px;
  }

  .adivasi-herbs-spotlight__title {
    font-size: 32px;
    font-weight: 800;
    color: #0a3a2f;
    margin: 0 0 12px;
    line-height: 1.25;
  }

  .adivasi-herbs-spotlight__subtitle {
    font-size: 14.5px;
    color: #4b5563;
    line-height: 1.5;
    margin: 0;
  }

  .adivasi-herbs-spotlight__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 30px;
  }

  .adivasi-herb-card {
    background: #fbf9f4;
    border: 1px solid #ebdcc5;
    border-radius: 12px;
    padding: 22px 18px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .adivasi-herb-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(10, 58, 47, 0.08);
    border-color: #c59b27;
  }

  .adivasi-herb-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .adivasi-herb-card__tag {
    font-size: 10.5px;
    font-weight: 800;
    color: #c59b27;
    letter-spacing: 0.8px;
  }

  .adivasi-herb-card__emoji {
    font-size: 22px;
  }

  .adivasi-herb-card__name {
    font-size: 16px;
    font-weight: 800;
    color: #0a3a2f;
    margin: 0 0 3px;
  }

  .adivasi-herb-card__sanskrit {
    display: block;
    font-size: 11.5px;
    color: #854d0e;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .adivasi-herb-card__desc {
    font-size: 12.5px;
    color: #4b5563;
    line-height: 1.45;
    margin: 0;
  }

  .adivasi-herbs-spotlight__callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0a3a2f;
    color: #ffffff;
    padding: 18px 24px;
    border-radius: 12px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .adivasi-herbs-spotlight__callout-icon {
    font-size: 28px;
  }

  .adivasi-herbs-spotlight__callout-text {
    flex: 1;
    font-size: 13.5px;
    line-height: 1.4;
    color: #e2f0ec;
  }

  .adivasi-herbs-spotlight__callout-btn {
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 13px;
    padding: 10px 20px;
    border-radius: 8px;
    white-space: nowrap;
    transition: transform 0.2s;
  }

  .adivasi-herbs-spotlight__callout-btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .adivasi-herbs-spotlight__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .adivasi-herbs-spotlight {
      padding: 40px 0;
    }
    .adivasi-herbs-spotlight__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .adivasi-herbs-spotlight__title {
      font-size: 24px;
    }
    .adivasi-herbs-spotlight__callout {
      flex-direction: column;
      text-align: center;
      padding: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Adivasi Herbs Spotlight",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Adivasi Herbs Spotlight"
    }
  ]
}
{% endschema %}

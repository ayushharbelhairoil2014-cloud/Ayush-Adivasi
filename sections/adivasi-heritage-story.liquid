{% comment %}
  Adivasi Authentic Founder & Pakshirajapura Heritage Story Section
{% endcomment %}

<div class="adivasi-heritage section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="adivasi-heritage__grid">
      <!-- Left: Real Founder Images Collage -->
      <div class="adivasi-heritage__media-col">
        <div class="adivasi-heritage__img-main-wrap">
          <img
            src="https://cdn.shopify.com/s/files/1/0835/1957/0173/files/WhatsAppImage2024-04-23at5.10.00PM_1.webp?v=1786266995"
            alt="Adivasi Hakki-Pikki Founder - Long Thick Hair"
            class="adivasi-heritage__img-main"
            width="500"
            height="500"
            loading="lazy"
          >
          <div class="adivasi-heritage__caption">
            <strong>Hakki-Pikki Ancestral Founder</strong>
            <span>Proof of 108 Wild Forest Herbs Potency</span>
          </div>
        </div>

        <div class="adivasi-heritage__sub-imgs">
          <img
            src="https://cdn.shopify.com/s/files/1/0835/1957/0173/files/WhatsApp_Image_2026-06-19_at_10.33.43.webp?v=1786266995"
            alt="Pakshirajapura Tribal Community"
            class="adivasi-heritage__sub-img"
            width="240"
            height="180"
            loading="lazy"
          >
          <img
            src="https://cdn.shopify.com/s/files/1/0835/1957/0173/files/WhatsAppImage2024-04-23at5.10.00PM_2_1.jpg?v=1786266995"
            alt="Ancestral Woodfire Brewing"
            class="adivasi-heritage__sub-img"
            width="240"
            height="180"
            loading="lazy"
          >
        </div>
      </div>

      <!-- Right: Story Content -->
      <div class="adivasi-heritage__text-col">
        <span class="adivasi-heritage__pill">ORIGIN: PAKSHIRAJAPURA, MYSORE</span>
        <h2 class="adivasi-heritage__title">
          "We Do Not Make Oil in Chemical Factories. We Brew It Over Woodfire With Sacred Jungle Roots."
        </h2>

        <p class="adivasi-heritage__lead">
          For over 4 generations, our Hakki-Pikki tribal community in Pakshirajapura (Hunsur Taluk, Mysore, Karnataka) has preserved the secret Vedic formulation of 108 rare forest herbs.
        </p>

        <div class="adivasi-heritage__points">
          <div class="adivasi-point">
            <span class="adivasi-point__icon">🪵</span>
            <div>
              <strong>Pure Woodfire Brewing:</strong>
              <p>Boiled slowly over firewood for 12 hours so the active phytochemicals from roots infuse without losing their natural life force.</p>
            </div>
          </div>

          <div class="adivasi-point">
            <span class="adivasi-point__icon">🛡️</span>
            <div>
              <strong>Beware of Cheap Duplicate Oils:</strong>
              <p>Real Adivasi oil comes sealed with a 3D security hologram. It carries natural herb sediments at the bottom, not artificial green food coloring.</p>
            </div>
          </div>

          <div class="adivasi-point">
            <span class="adivasi-point__icon">📦</span>
            <div>
              <strong>100% Cash On Delivery Confidence:</strong>
              <p>We trust our roots. Pay only when our courier executive delivers the authentic bottle safely into your hands.</p>
            </div>
          </div>
        </div>

        <div class="adivasi-heritage__cta">
          <a href="/products/original-adivasi-hakki-pikki-hair-oil" class="adivasi-heritage__btn">
            ORDER ORIGINAL OIL &mdash; CASH ON DELIVERY
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .adivasi-heritage {
    padding: 60px 0;
    background: #fbf9f4;
    border-top: 1px solid #ebdcc5;
    border-bottom: 1px solid #ebdcc5;
  }

  .adivasi-heritage__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }

  .adivasi-heritage__img-main-wrap {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 2px solid #c59b27;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  }

  .adivasi-heritage__img-main {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .adivasi-heritage__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(10, 58, 47, 0.95) 40%);
    color: #ffffff;
    padding: 24px 16px 12px;
    display: flex;
    flex-direction: column;
  }

  .adivasi-heritage__caption strong {
    font-size: 14px;
    color: #f6cb59;
  }

  .adivasi-heritage__caption span {
    font-size: 11px;
    color: #dcfce7;
  }

  .adivasi-heritage__sub-imgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 12px;
  }

  .adivasi-heritage__sub-img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #ebdcc5;
  }

  /* Content */
  .adivasi-heritage__pill {
    display: inline-block;
    background: rgba(197, 155, 39, 0.18);
    color: #926a11;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
  }

  .adivasi-heritage__title {
    font-size: 28px;
    font-weight: 800;
    color: #0a3a2f;
    line-height: 1.3;
    margin: 0 0 14px;
  }

  .adivasi-heritage__lead {
    font-size: 14.5px;
    color: #4b5563;
    line-height: 1.55;
    margin: 0 0 22px;
  }

  .adivasi-heritage__points {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 26px;
  }

  .adivasi-point {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: #ffffff;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid #eee7db;
  }

  .adivasi-point__icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .adivasi-point strong {
    font-size: 13.5px;
    color: #0a3a2f;
    display: block;
    margin-bottom: 3px;
  }

  .adivasi-point p {
    font-size: 12px;
    color: #555555;
    line-height: 1.45;
    margin: 0;
  }

  .adivasi-heritage__btn {
    display: inline-block;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    padding: 13px 26px;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(22, 163, 74, 0.4);
    transition: transform 0.2s;
  }

  .adivasi-heritage__btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .adivasi-heritage__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .adivasi-heritage {
      padding: 40px 0;
    }
    .adivasi-heritage__title {
      font-size: 22px;
    }
  }
</style>

{% schema %}
{
  "name": "Adivasi Heritage Story",
  "settings": [],
  "presets": [
    {
      "name": "Adivasi Heritage Story"
    }
  ]
}
{% endschema %}

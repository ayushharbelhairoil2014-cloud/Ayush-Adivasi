{% comment %}
  Adivasi Hero Banner Section - Ultra Premium Ayurvedic Visual Design
  Features authentic bottle photography, Pakshirajapura heritage badge, real ratings, and direct 1-Click COD action.
{% endcomment %}

<div class="adivasi-hero section-{{ section.id }}-padding" style="background-color: {{ section.settings.bg_color }};">
  <div class="adivasi-hero__container page-width">
    <div class="adivasi-hero__grid">
      <!-- Left Content Column -->
      <div class="adivasi-hero__content">
        <div class="adivasi-hero__badge">
          <span class="adivasi-hero__badge-icon">🌿</span>
          <span class="adivasi-hero__badge-text">{{ section.settings.badge_text }}</span>
        </div>

        <h1 class="adivasi-hero__heading">
          Stop Hair Fall &amp; Regrow Thick Hair With <span>108 Wild Forest Herbs</span>
        </h1>

        <p class="adivasi-hero__subheading">
          Handcrafted by authentic Hakki-Pikki tribal elders in Pakshirajapura, Mysore. Slow-brewed for 12 hours over open woodfire. Halts hair shedding within 14 days.
        </p>

        <!-- Social Proof Rating -->
        <div class="adivasi-hero__rating">
          <div class="adivasi-hero__stars">★★★★★</div>
          <span class="adivasi-hero__rating-text">
            <strong>4.9/5 Rating</strong> &bull; 80,200+ Happy Customers &bull; 136K+ Bottles Sold
          </span>
        </div>

        <!-- Bottle Size Selector Cards -->
        <div class="adivasi-hero__sizes">
          <a href="{{ section.settings.cta_link }}?variant=250ml" class="adivasi-hero__size-pill">
            <span class="adivasi-hero__size-title">250 ML Starter</span>
            <span class="adivasi-hero__size-price">₹899</span>
          </a>
          <a href="{{ section.settings.cta_link }}?variant=500ml" class="adivasi-hero__size-pill is-popular">
            <span class="adivasi-hero__size-tag">MOST POPULAR</span>
            <span class="adivasi-hero__size-title">500 ML Regular</span>
            <span class="adivasi-hero__size-price">₹1,299</span>
          </a>
          <a href="{{ section.settings.cta_link }}?variant=1000ml" class="adivasi-hero__size-pill">
            <span class="adivasi-hero__size-title">1000 ML Family</span>
            <span class="adivasi-hero__size-price">₹2,499</span>
          </a>
        </div>

        <!-- Action CTAs -->
        <div class="adivasi-hero__ctas">
          <a href="{{ section.settings.cta_link }}" class="adivasi-hero__btn-cod">
            <span class="adivasi-hero__btn-icon">📦</span>
            <span class="adivasi-hero__btn-text">
              <strong>ORDER NOW &mdash; CASH ON DELIVERY</strong>
              <small>Pay When You Receive &bull; Free Express Delivery Across India</small>
            </span>
          </a>
        </div>

        <!-- Micro Trust Row -->
        <div class="adivasi-hero__trust-row">
          <div class="adivasi-hero__trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C59B27" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>100% Herbal Roots</span>
          </div>
          <div class="adivasi-hero__trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C59B27" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Woodfire Brewed</span>
          </div>
          <div class="adivasi-hero__trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C59B27" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Official Hologram</span>
          </div>
        </div>
      </div>

      <!-- Right Visual Column with Real Bottle Image -->
      <div class="adivasi-hero__visual">
        <div class="adivasi-hero__card">
          <div class="adivasi-hero__card-badge">AUTHENTIC PAKSHIRAJAPURA OIL</div>
          
          <div class="adivasi-hero__image-container">
            <img
              src="{{ section.settings.product_image | default: 'https://cdn.shopify.com/s/files/1/0835/1957/0173/files/An_XIlT9GYEXOrEVOq3PF0ydGYR9eaupCWugOJI8gGmd1OhevHB-OrHouCNL-gafyvsAVaj9VG9mwnizFqctWrDETFe8NaN4gYw7v5ahQ0a81f2cHvCQ3FVO3hz22eGZ4qerfJtQpcuQbfLVm9QAoKyKlpTQMajGwp88tBQTlNKiSvYykQjL37T.webp?v=1786266995' }}"
              alt="Original Adivasi Hakki Pikki Herbal Hair Oil Bottle"
              class="adivasi-hero__bottle-img"
              width="450"
              height="450"
              loading="eager"
            >
            <div class="adivasi-hero__stamp">
              <span>100%</span>
              <small>ORIGINAL</small>
            </div>
          </div>

          <div class="adivasi-hero__card-body">
            <div class="adivasi-hero__card-title">Original Adivasi Hakki Pikki Hair Oil</div>
            <div class="adivasi-hero__card-origin">2nd Pakshirajapura, Hunsur Taluk, Mysore, Karnataka</div>
            
            <div class="adivasi-hero__price-box">
              <span class="adivasi-hero__current-price">₹899</span>
              <span class="adivasi-hero__old-price">₹1,799</span>
              <span class="adivasi-hero__save-pill">FLAT 50% OFF</span>
            </div>

            <div class="adivasi-hero__urgency">
              <span class="adivasi-hero__pulse-dot"></span>
              <span>🔥 <strong>High Demand:</strong> Only 14 bottles left in today's woodfire batch!</span>
            </div>

            <a href="{{ section.settings.cta_link }}" class="adivasi-hero__card-btn">
              CLAIM 50% OFF &amp; ORDER COD &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .adivasi-hero {
    position: relative;
    padding: 36px 0 48px;
    background: radial-gradient(circle at 10% 20%, #0d4639 0%, #0a3a2f 60%, #06261f 100%);
    color: #ffffff;
    overflow: hidden;
  }

  .adivasi-hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(rgba(197, 155, 39, 0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .adivasi-hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 36px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .adivasi-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(197, 155, 39, 0.18);
    border: 1px solid #c59b27;
    color: #f7d57f;
    padding: 5px 14px;
    border-radius: 30px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.6px;
    margin-bottom: 14px;
  }

  .adivasi-hero__heading {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 14px;
    letter-spacing: -0.4px;
  }

  .adivasi-hero__heading span {
    color: #f6cb59;
    text-decoration: underline;
    text-decoration-color: #c59b27;
  }

  .adivasi-hero__subheading {
    font-size: 15px;
    line-height: 1.5;
    color: #e2f0ec;
    margin: 0 0 18px;
    max-width: 580px;
  }

  .adivasi-hero__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .adivasi-hero__stars {
    color: #fbbf24;
    font-size: 18px;
    letter-spacing: 2px;
  }

  .adivasi-hero__rating-text {
    font-size: 12.5px;
    color: #d1fae5;
  }

  /* Size Selector Pills */
  .adivasi-hero__sizes {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .adivasi-hero__size-pill {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.08);
    border: 1.5px solid rgba(197, 155, 39, 0.4);
    border-radius: 8px;
    padding: 8px 14px;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.2s;
  }

  .adivasi-hero__size-pill:hover,
  .adivasi-hero__size-pill.is-popular {
    background: rgba(197, 155, 39, 0.2);
    border-color: #c59b27;
    transform: translateY(-2px);
  }

  .adivasi-hero__size-tag {
    position: absolute;
    top: -9px;
    right: 8px;
    background: #c59b27;
    color: #0a3a2f;
    font-size: 8.5px;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 10px;
    letter-spacing: 0.5px;
  }

  .adivasi-hero__size-title {
    font-size: 11.5px;
    font-weight: 700;
  }

  .adivasi-hero__size-price {
    font-size: 14px;
    font-weight: 800;
    color: #f6cb59;
  }

  .adivasi-hero__ctas {
    margin-bottom: 22px;
  }

  .adivasi-hero__btn-cod {
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #ffffff;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 6px 22px rgba(22, 163, 74, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
    max-width: 480px;
    animation: adivasi-hero-pulse 2.2s infinite;
  }

  @keyframes adivasi-hero-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.7); }
    50% { box-shadow: 0 0 0 8px rgba(22, 163, 74, 0); }
  }

  .adivasi-hero__btn-cod:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(22, 163, 74, 0.6);
  }

  .adivasi-hero__btn-icon {
    font-size: 24px;
  }

  .adivasi-hero__btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .adivasi-hero__btn-text strong {
    font-size: 14.5px;
    letter-spacing: 0.5px;
  }

  .adivasi-hero__btn-text small {
    font-size: 10.5px;
    color: #dcfce7;
    margin-top: 2px;
  }

  .adivasi-hero__trust-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .adivasi-hero__trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #f3efe6;
    font-weight: 600;
  }

  /* Right Visual Card */
  .adivasi-hero__card {
    position: relative;
    background: #ffffff;
    color: #1a2421;
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    border: 2px solid #c59b27;
  }

  .adivasi-hero__card-badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: #0a3a2f;
    color: #f6cb59;
    border: 1px solid #c59b27;
    font-size: 10.5px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.6px;
  }

  .adivasi-hero__image-container {
    position: relative;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    background: #fbf9f4;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border: 1px solid #ebdcc5;
  }

  .adivasi-hero__bottle-img {
    width: 100%;
    max-height: 320px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .adivasi-hero__bottle-img:hover {
    transform: scale(1.03);
  }

  .adivasi-hero__stamp {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 60px;
    height: 60px;
    background: #c59b27;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    border: 2px dashed #ffffff;
  }

  .adivasi-hero__stamp span {
    font-size: 13px;
  }

  .adivasi-hero__stamp small {
    font-size: 8px;
    letter-spacing: 0.5px;
  }

  .adivasi-hero__card-title {
    font-size: 18px;
    font-weight: 800;
    color: #0a3a2f;
    margin-bottom: 3px;
  }

  .adivasi-hero__card-origin {
    font-size: 11.5px;
    color: #6b7280;
    margin-bottom: 12px;
  }

  .adivasi-hero__price-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fbf9f4;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #ebdcc5;
    margin-bottom: 12px;
  }

  .adivasi-hero__current-price {
    font-size: 22px;
    font-weight: 900;
    color: #0a3a2f;
  }

  .adivasi-hero__old-price {
    font-size: 14px;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .adivasi-hero__save-pill {
    background: #dc2626;
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .adivasi-hero__urgency {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: #991b1b;
    background: #fef2f2;
    padding: 7px 10px;
    border-radius: 6px;
    margin-bottom: 14px;
    border: 1px solid #fecaca;
  }

  .adivasi-hero__pulse-dot {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 50%;
    animation: adivasi-dot-pulse 1.4s infinite;
    flex-shrink: 0;
  }

  @keyframes adivasi-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .adivasi-hero__card-btn {
    display: block;
    width: 100%;
    text-align: center;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 13.5px;
    padding: 12px;
    border-radius: 8px;
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4);
    letter-spacing: 0.4px;
    transition: transform 0.2s;
  }

  .adivasi-hero__card-btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .adivasi-hero {
      padding: 24px 0 34px;
    }
    .adivasi-hero__grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .adivasi-hero__heading {
      font-size: 26px;
    }
    .adivasi-hero__subheading {
      font-size: 13.5px;
    }
    .adivasi-hero__btn-cod {
      max-width: 100%;
    }
    .adivasi-hero__bottle-img {
      max-height: 250px;
    }
  }
</style>

{% schema %}
{
  "name": "Adivasi Hero Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A3A2F"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "100% ORIGINAL PAKSHIRAJAPURA AYUSH HERBAL"
    },
    {
      "type": "text",
      "id": "product_image",
      "label": "Product Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0835/1957/0173/files/An_XIlT9GYEXOrEVOq3PF0ydGYR9eaupCWugOJI8gGmd1OhevHB-OrHouCNL-gafyvsAVaj9VG9mwnizFqctWrDETFe8NaN4gYw7v5ahQ0a81f2cHvCQ3FVO3hz22eGZ4qerfJtQpcuQbfLVm9QAoKyKlpTQMajGwp88tBQTlNKiSvYykQjL37T.webp?v=1786266995"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary CTA Link",
      "default": "/products/original-adivasi-hakki-pikki-hair-oil"
    }
  ],
  "presets": [
    {
      "name": "Adivasi Hero Banner"
    }
  ]
}
{% endschema %}

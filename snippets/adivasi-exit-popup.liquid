{% comment %}
  Adivasi Exit-Intent Popup
  Captures abandoning visitors on desktop/mobile with a special Cash on Delivery discount / gift incentive.
  Uses sessionStorage to trigger only once per visit.
{% endcomment %}

<div class="adivasi-exit-modal" id="AdivasiExitModal" aria-hidden="true">
  <div class="adivasi-exit-modal__backdrop" onclick="closeAdivasiExitModal()"></div>
  <div class="adivasi-exit-modal__dialog">
    <button type="button" class="adivasi-exit-modal__close" onclick="closeAdivasiExitModal()" aria-label="Close modal">&times;</button>
    
    <div class="adivasi-exit-modal__header">
      <span class="adivasi-exit-modal__pill">WAIT! BEFORE YOU GO...</span>
      <h3 class="adivasi-exit-modal__title">Get FREE Neem Wood Comb + Extra ₹150 OFF</h3>
      <p class="adivasi-exit-modal__subtitle">Apply coupon on Cash On Delivery (COD) order today!</p>
    </div>

    <div class="adivasi-exit-modal__coupon-box">
      <div class="adivasi-exit-modal__code">AYUSH150</div>
      <button type="button" class="adivasi-exit-modal__copy-btn" id="ExitCopyBtn" onclick="copyExitCoupon()">
        Copy Code
      </button>
    </div>

    <ul class="adivasi-exit-modal__perks">
      <li>🌿 100% Herbal &bull; Handcrafted by Mysore Adivasi Elders</li>
      <li>📦 Cash on Delivery &bull; Zero Prepayment Risk</li>
      <li>🚚 Free Express 3-5 Days Doorstep Delivery</li>
    </ul>

    <a href="/products/original-adivasi-hakki-pikki-hair-oil" class="adivasi-exit-modal__cta" onclick="claimExitDiscount()">
      CLAIM ₹150 OFF &amp; SHOP COD
    </a>

    <button type="button" class="adivasi-exit-modal__decline" onclick="closeAdivasiExitModal()">
      No thanks, I prefer paying full price
    </button>
  </div>
</div>

<style>
  .adivasi-exit-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    padding: 16px;
  }

  .adivasi-exit-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .adivasi-exit-modal__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 58, 47, 0.75);
    backdrop-filter: blur(4px);
  }

  .adivasi-exit-modal__dialog {
    position: relative;
    background: #ffffff;
    border-radius: 14px;
    padding: 28px 24px;
    max-width: 440px;
    width: 100%;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
    border: 2px solid #c59b27;
    text-align: center;
    transform: translateY(20px) scale(0.96);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .adivasi-exit-modal.is-open .adivasi-exit-modal__dialog {
    transform: translateY(0) scale(1);
  }

  .adivasi-exit-modal__close {
    position: absolute;
    top: 10px;
    right: 14px;
    background: none;
    border: none;
    font-size: 26px;
    color: #6b7280;
    cursor: pointer;
  }

  .adivasi-exit-modal__pill {
    display: inline-block;
    background: #fef3c7;
    color: #92400e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 8px;
  }

  .adivasi-exit-modal__title {
    font-size: 20px;
    font-weight: 800;
    color: #0a3a2f;
    line-height: 1.25;
    margin: 4px 0 6px;
  }

  .adivasi-exit-modal__subtitle {
    font-size: 13px;
    color: #4b5563;
    margin: 0 0 16px;
  }

  .adivasi-exit-modal__coupon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fbf9f4;
    border: 2px dashed #c59b27;
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 16px;
    gap: 14px;
  }

  .adivasi-exit-modal__code {
    font-family: monospace;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #0a3a2f;
  }

  .adivasi-exit-modal__copy-btn {
    background: #0a3a2f;
    color: #ffffff;
    border: none;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .adivasi-exit-modal__copy-btn:hover {
    background: #16a34a;
  }

  .adivasi-exit-modal__perks {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    text-align: left;
    font-size: 12px;
    color: #374151;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .adivasi-exit-modal__cta {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    color: #ffffff;
    text-decoration: none;
    padding: 13px 18px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 14px;
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .adivasi-exit-modal__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(22, 163, 74, 0.55);
  }

  .adivasi-exit-modal__decline {
    background: none;
    border: none;
    color: #9ca3af;
    font-size: 11.5px;
    cursor: pointer;
    margin-top: 10px;
    text-decoration: underline;
  }
</style>

<script>
  (function () {
    let modalShown = false;

    function triggerExitModal() {
      if (modalShown || sessionStorage.getItem('adivasi_exit_shown') === 'true') return;
      const modal = document.getElementById('AdivasiExitModal');
      if (modal) {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        modalShown = true;
        sessionStorage.setItem('adivasi_exit_shown', 'true');
      }
    }

    window.closeAdivasiExitModal = function () {
      const modal = document.getElementById('AdivasiExitModal');
      if (modal) {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      }
    };

    window.copyExitCoupon = function () {
      navigator.clipboard.writeText('AYUSH150').then(() => {
        const btn = document.getElementById('ExitCopyBtn');
        if (btn) btn.textContent = 'Copied! ✓';
      });
    };

    window.claimExitDiscount = function () {
      closeAdivasiExitModal();
    };

    // Desktop mouseleave detect
    document.addEventListener('mouseleave', function (e) {
      if (e.clientY <= 0) {
        triggerExitModal();
      }
    });

    // Mobile back-button or inactivity (18s delay trigger)
    setTimeout(function () {
      if (!modalShown && sessionStorage.getItem('adivasi_exit_shown') !== 'true') {
        // Only trigger if mobile scroll reached 40%
        const scrollPercent = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
        if (scrollPercent > 35) {
          triggerExitModal();
        }
      }
    }, 28000);
  })();
</script>

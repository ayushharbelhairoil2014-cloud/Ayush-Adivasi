    font-size: 13px;
    font-weight: 700;
    color: #4b5563;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .adivasi-rich-tabs__tab:hover {
    color: #0a3a2f;
    background: rgba(10, 58, 47, 0.03);
  }

  .adivasi-rich-tabs__tab.is-active {
    color: #0a3a2f;
    border-bottom-color: #0a3a2f;
    background: #ffffff;
  }

  .adivasi-rich-tabs__content-wrap {
    padding: 20px;
  }

  .adivasi-rich-tabs__panel {
    display: none;
  }

  .adivasi-rich-tabs__panel.is-active {
    display: block;
    animation: adivasi-fade-in 0.25s ease;
  }

  @keyframes adivasi-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Benefits Grid */
  .adivasi-benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .adivasi-benefit-card {
    background: #fbf9f4;
    border: 1px solid #eee7db;
    border-radius: 8px;
    padding: 14px;
  }

  .adivasi-benefit-card__icon {

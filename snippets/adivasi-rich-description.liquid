    margin: 0 0 3px;
    font-size: 13px;
    color: #0a3a2f;
    font-weight: 800;
  }

  .adivasi-ritual-body p {
    margin: 0;
    font-size: 12px;
    color: #4b5563;
    line-height: 1.35;
  }

  /* Authenticity */
  .adivasi-auth-box {
    background: #fdfbf7;
    border: 1.5px solid #c59b27;
    border-radius: 10px;
    padding: 16px;
  }

  .adivasi-auth-badge {

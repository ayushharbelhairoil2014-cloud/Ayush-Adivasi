  }

  .adivasi-auth-checklist li {
    position: relative;
    padding-left: 18px;
    line-height: 1.35;
  }

  .adivasi-auth-checklist li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #16a34a;
    font-weight: 900;
  }

  @media (max-width: 600px) {
    .adivasi-benefits-grid,
    .adivasi-herbs-grid {
      grid-template-columns: 1fr;
    }
    .adivasi-rich-tabs__content-wrap {
      padding: 14px;
    }

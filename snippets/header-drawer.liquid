{% doc %}
  Renders a header drawer menu for mobile and desktop.

  @param {boolean} [show_country_selector] - Whether to render the country selector in the drawer.
  @param {boolean} [show_language_selector] - Whether to render the language selector in the drawer.
  @param {boolean} [show_social_links] - Whether to render social links list in the drawer.

  @example
  {% render 'header-drawer', show_language_selector: true %}
{% enddoc %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <style>
    /* ========================================================
       AYUSH ADIVASI LUXURY MOBILE MENU DRAWER
       ======================================================== */
    /* 1. Backdrop Dimming Overlay (Full Screen Blur) */
    header-drawer details[open] summary::before,
    header-drawer details.menu-opening summary::before,
    details[open].menu-drawer-container::before {
      content: '' !important;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      background: rgba(0, 0, 0, 0.72) !important;
      backdrop-filter: blur(5px) !important;
      -webkit-backdrop-filter: blur(5px) !important;
      z-index: 9998 !important;
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }

    /* 2. Menu Drawer Container (Solid Deep Forest Emerald Gradient) */
    #menu-drawer.menu-drawer {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      height: 100vh !important;
      height: 100dvh !important;
      width: 85vw !important;
      max-width: 340px !important;
      min-width: 280px !important;
      background: #051c17 !important;
      background: linear-gradient(180deg, #041814 0%, #06261f 50%, #0a3a2f 100%) !important;
      color: #ffffff !important;
      border-right: 2px solid #c59b27 !important;
      box-shadow: 12px 0 36px rgba(0, 0, 0, 0.75) !important;
      z-index: 9999 !important;
      transform: translateX(-100%) !important;
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.32s ease !important;
      visibility: hidden !important;
      display: flex !important;
      flex-direction: column !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch !important;
      box-sizing: border-box !important;
    }

    /* Open State */
    details[open] #menu-drawer.menu-drawer,
    details[open].menu-opening #menu-drawer.menu-drawer {
      transform: translateX(0) !important;
      visibility: visible !important;
    }

    /* 3. Branded Drawer Top Bar */
    .adivasi-drawer-top {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding: 20px 18px 16px 18px !important;
      min-height: 64px !important;
      background: rgba(0, 0, 0, 0.35) !important;
      border-bottom: 1.5px solid rgba(197, 155, 39, 0.3) !important;
      flex-shrink: 0 !important;
      box-sizing: border-box !important;
    }

    .adivasi-drawer-branding {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
    }

    .adivasi-drawer-herb-icon {
      font-size: 22px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      background: rgba(197, 155, 39, 0.2) !important;
      border: 1.5px solid #c59b27 !important;
      border-radius: 50% !important;
      width: 38px !important;
      height: 38px !important;
    }

    .adivasi-drawer-title-group {
      display: flex !important;
      flex-direction: column !important;
    }

    .adivasi-drawer-main-title {
      font-size: 14.5px !important;
      font-weight: 800 !important;
      color: #ffffff !important;
      letter-spacing: 0.8px !important;
      text-transform: uppercase !important;
    }

    .adivasi-drawer-sub-title {
      font-size: 11px !important;
      color: #f6cb59 !important;
      font-weight: 500 !important;
      letter-spacing: 0.3px !important;
    }

    .adivasi-drawer-close-btn {
      background: rgba(255, 255, 255, 0.12) !important;
      border: 1px solid rgba(255, 255, 255, 0.25) !important;
      color: #ffffff !important;
      width: 32px !important;
      height: 32px !important;
      border-radius: 50% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      font-size: 14px !important;
      font-weight: 700 !important;
      cursor: pointer !important;
      transition: all 0.2s ease !important;
    }

    .adivasi-drawer-close-btn:hover {
      background: #c59b27 !important;
      color: #06261f !important;
      border-color: #c59b27 !important;
      transform: scale(1.08);
    }

    /* 4. Drawer Menu Links */
    .menu-drawer__navigation {
      padding: 8px 0 !important;
    }

    .menu-drawer__menu li {
      margin: 0 !important;
      border-bottom: 1px solid rgba(197, 155, 39, 0.14) !important;
    }

    .menu-drawer__menu-item,
    .menu-drawer__menu-item.list-menu__item {
      color: #ffffff !important;
      font-size: 15px !important;
      font-weight: 600 !important;
      letter-spacing: 0.3px !important;
      padding: 14px 20px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      text-decoration: none !important;
      transition: all 0.2s ease !important;
    }

    .menu-drawer__menu-item:hover,
    .menu-drawer__menu-item:active,
    .menu-drawer__menu-item--active {
      background: rgba(197, 155, 39, 0.18) !important;
      color: #f6cb59 !important;
      padding-left: 24px !important;
    }

    .menu-drawer__menu-item span.svg-wrapper {
      color: #c59b27 !important;
    }
  </style>

  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <!-- Branded Header inside Drawer -->
      <div class="adivasi-drawer-top">
        <div class="adivasi-drawer-branding">
          <span class="adivasi-drawer-herb-icon">🌿</span>
          <div class="adivasi-drawer-title-group">
            <span class="adivasi-drawer-main-title">AYUSH ADIVASI</span>
            <span class="adivasi-drawer-sub-title">Authentic Mysore Hair Oil</span>
          </div>
        </div>
        <button
          type="button"
          class="adivasi-drawer-close-btn"
          aria-label="Close menu"
          onclick="document.getElementById('Details-menu-drawer-container').removeAttribute('open'); document.getElementById('Details-menu-drawer-container').classList.remove('menu-opening'); document.body.classList.remove('overflow-hidden-tablet', 'overflow-hidden-desktop');"
        >
          ✕
        </button>
      </div>

      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- if section.settings.menu.links != blank and section.settings.menu.links.size > 0 -%}
                {%- for link in section.settings.menu.links -%}
                  {%- assign dest_drawer_url = link.url -%}
                  {%- if dest_drawer_url contains '/collections/all' or dest_drawer_url == '#' -%}
                    {%- assign dest_drawer_url = '/products/original-adivasi-hakki-pikki-hair-oil' -%}
                  {%- endif -%}
                  <li>
                    {%- if link.links != blank -%}
                      <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                        <summary
                          id="HeaderDrawer-{{ link.handle }}"
                          class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                        >
                          {{ link.title | escape }}
                          <span class="svg-wrapper">
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                          </span>
                          <span class="svg-wrapper">
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                          </span>
                        </summary>
                        <div
                          id="link-{{ link.handle | escape }}"
                          class="menu-drawer__submenu has-submenu gradient motion-reduce"
                          tabindex="-1"
                        >
                          <div class="menu-drawer__inner-submenu">
                            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                              <span class="svg-wrapper">
                                {{- 'icon-arrow.svg' | inline_asset_content -}}
                              </span>
                              {{ link.title | escape }}
                            </button>
                            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                              {%- for childlink in link.links -%}
                                {%- assign child_drawer_url = childlink.url -%}
                                {%- if child_drawer_url contains '/collections/all' or child_drawer_url == '#' -%}
                                  {%- assign child_drawer_url = '/products/original-adivasi-hakki-pikki-hair-oil' -%}
                                {%- endif -%}
                                <li>
                                  {%- if childlink.links == blank -%}
                                    <a
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      href="{{ child_drawer_url }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                      {% if childlink.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      {{ childlink.title | escape }}
                                    </a>
                                  {%- else -%}
                                    <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                      <summary
                                        id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                        class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                      >
                                        {{ childlink.title | escape }}
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        <span class="svg-wrapper">
                                          {{- 'icon-caret.svg' | inline_asset_content -}}
                                        </span>
                                      </summary>
                                      <div
                                        id="childlink-{{ childlink.handle | escape }}"
                                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                      >
                                        <button
                                          class="menu-drawer__close-button link link--text focus-inset"
                                          aria-expanded="true"
                                        >
                                          <span class="svg-wrapper">
                                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                                          </span>
                                          {{ childlink.title | escape }}
                                        </button>
                                        <ul
                                          class="menu-drawer__menu list-menu"
                                          role="list"
                                          tabindex="-1"
                                        >
                                          {%- for grandchildlink in childlink.links -%}
                                            {%- assign gchild_drawer_url = grandchildlink.url -%}
                                            {%- if gchild_drawer_url contains '/collections/all' or gchild_drawer_url == '#' -%}
                                              {%- assign gchild_drawer_url = '/products/original-adivasi-hakki-pikki-hair-oil' -%}
                                            {%- endif -%}
                                            <li>
                                              <a
                                                id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                                href="{{ gchild_drawer_url }}"
                                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                                {% if grandchildlink.current %}
                                                  aria-current="page"
                                                {% endif %}
                                              >
                                                {{ grandchildlink.title | escape }}
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      </div>
                                    </details>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </div>
                      </details>
                    {%- else -%}
                      <a
                        id="HeaderDrawer-{{ link.handle }}"
                        href="{{ dest_drawer_url }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              {%- else -%}
                <!-- Authentic Adivasi Mobile Menu Items -->
                <li>
                  <a href="/" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    🏠 Home
                  </a>
                </li>
                <li>
                  <a href="/products/original-adivasi-hakki-pikki-hair-oil" class="menu-drawer__menu-item list-menu__item link link--text focus-inset" style="color: #f6cb59 !important; font-weight: 800;">
                    🌿 Original Hair Oil (50% OFF)
                  </a>
                </li>
                <li>
                  <a href="/pages/how-to-use" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    📖 How To Use Ritual
                  </a>
                </li>
                <li>
                  <a href="/#herbs-spotlight" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    🍃 108 Sacred Herbs
                  </a>
                </li>
                <li>
                  <a href="/#heritage-story" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    📜 Tribal Origin &amp; Cauldron
                  </a>
                </li>
                <li>
                  <a href="/#real-vs-fake" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    🛡️ Real vs Fake Hologram
                  </a>
                </li>
                <li>
                  <a href="/pages/contact" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    📞 Helpline &amp; WhatsApp
                  </a>
                </li>
              {%- endif -%}
            </ul>
            
            <!-- Mobile Drawer Trust & WhatsApp CTA -->
            <div style="padding: 16px 20px; border-top: 1px solid rgba(197,155,39,0.2); margin-top: 15px;">
              <a href="https://wa.me/919880000000?text=Hello%20Ayush%20Adivasi,%20I%20want%20to%20order%20Original%20Hair%20Oil%20COD" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #16a34a; color: #ffffff; padding: 12px; border-radius: 8px; text-decoration: none; font-size: 13.5px; font-weight: 700;">
                <span>💬</span> Order on WhatsApp (COD)
              </a>
              <div style="font-size: 11px; text-align: center; color: rgba(255,255,255,0.7); margin-top: 8px;">
                📍 Origin: 2nd Pakshirajapura, Mysore • 100% Herbal
              </div>
            </div>
          </nav>
          <div class="menu-drawer__utility-links">
            {%- if show_country_selector or show_language_selector -%}
              <div class="menu-drawer__localization header-localization">
                {%- if show_country_selector -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if show_language_selector -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            {% if show_social_links %}
              <ul class="list list-social list-unstyled" role="list">
                {%- if settings.social_twitter_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-twitter.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-facebook.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_pinterest_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-pinterest.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-instagram.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-tiktok.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tumblr_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-tumblr.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_snapchat_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-snapchat.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-youtube.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_vimeo_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-vimeo.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

{% comment %}
  Adivasi Official Trust & Purity Badges
  High-converting trust signals with elegant golden & forest emerald accents.
{% endcomment %}

<div class="adivasi-trust-badges">
  <div class="adivasi-trust-badge">
    <div class="adivasi-trust-badge__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C59B27" stroke-width="2">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
      </svg>
    </div>
    <div class="adivasi-trust-badge__meta">
      <span class="adivasi-trust-badge__title">100% Herbal</span>
      <span class="adivasi-trust-badge__desc">108 Wild Forest Roots</span>
    </div>
  </div>

  <div class="adivasi-trust-badge">
    <div class="adivasi-trust-badge__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C59B27" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
    </div>
    <div class="adivasi-trust-badge__meta">
      <span class="adivasi-trust-badge__title">Ayush Approved</span>
      <span class="adivasi-trust-badge__desc">GMP &amp; ISO Certified</span>
    </div>
  </div>

  <div class="adivasi-trust-badge">
    <div class="adivasi-trust-badge__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C59B27" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
    </div>
    <div class="adivasi-trust-badge__meta">
      <span class="adivasi-trust-badge__title">Woodfire Brewed</span>
      <span class="adivasi-trust-badge__desc">12-Hour Ancestral Recipe</span>
    </div>
  </div>

  <div class="adivasi-trust-badge">
    <div class="adivasi-trust-badge__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C59B27" stroke-width="2">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <div class="adivasi-trust-badge__meta">
      <span class="adivasi-trust-badge__title">Cash On Delivery</span>
      <span class="adivasi-trust-badge__desc">All Pincodes in India</span>
    </div>
  </div>
</div>

<style>
  .adivasi-trust-badges {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    padding: 14px;
    background: #fbf9f4;
    border: 1px solid #ebdcc5;
    border-radius: 10px;
    margin: 16px 0;
  }

  .adivasi-trust-badge {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .adivasi-trust-badge__icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e2cfb0;
    flex-shrink: 0;
  }

  .adivasi-trust-badge__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .adivasi-trust-badge__title {
    font-size: 12px;
    font-weight: 800;
    color: #0a3a2f;
  }

  .adivasi-trust-badge__desc {
    font-size: 10px;
    color: #6b7280;
    margin-top: 2px;
  }

  @media (max-width: 768px) {
    .adivasi-trust-badges {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 8px;
      padding: 12px 10px;
    }
    .adivasi-trust-badge__icon {
      width: 32px;
      height: 32px;
    }
    .adivasi-trust-badge__title {
      font-size: 11px;
    }
    .adivasi-trust-badge__desc {
      font-size: 9px;
    }
  }
</style>
